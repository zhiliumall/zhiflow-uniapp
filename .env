# ============================================================
# 智流商城 H5 用户端配置（所有环境通用）
# 本机覆盖写在 .env.local / .env.development.local（已在 .gitignore 里，不入库）
# ============================================================

# 后端地址。页面里的请求都是同源相对路径（/mallapi/**、/files/**）：
#   开发（npm run dev:h5）时由 vite 代理到这里；
#   上线后由 nginx 等反向代理转发到后端，见 README「部署」。
VITE_API_BASE=http://127.0.0.1:8080

# 商城名称（浏览器标题、页面抬头）与品牌短名（拼接用，留空则由全称去掉「商城」推出）
VITE_MALL_NAME=智流商城
VITE_MALL_NAME_SHORT=智流

# 微信公众号 appId：微信内网页授权登录与 JSAPI 支付用。留空 = 微信内不走网页授权，只能账号密码登录
VITE_GZH_APPID=

# 微信网页授权登录后，未绑手机号的用户是否必须先绑定（需后台已配置短信渠道）。默认不强制
VITE_FORCE_BIND_PHONE=false
